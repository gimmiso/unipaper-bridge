# Optional but recommended: identifies your deployment to Crossref's polite pool.
CROSSREF_MAILTO=research-tools@example.org

# Strongly recommended for higher OpenAlex usage limits in shared deployments.
# Citation expansion and OA lookup can start without one at the lower no-key quota.
# Create a free key at https://openalex.org/settings/api
OPENALEX_API_KEY=

# HTTP mode defaults.
PORT=3000
HOST=127.0.0.1

# Production examples behind one trusted reverse proxy:
# HOST=0.0.0.0
# ALLOWED_HOSTS=mcp.example.org
# TRUST_PROXY=1
