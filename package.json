{
  "name": "unipaper-bridge",
  "version": "0.1.0",
  "description": "A privacy-preserving MCP bridge from scholarly metadata to user-controlled institutional library access.",
  "type": "module",
  "bin": {
    "unipaper-bridge": "dist/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    ".codex-plugin/",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "TERMS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
